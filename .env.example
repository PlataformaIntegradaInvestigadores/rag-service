# Local development environment — copy to .env and adjust if needed.
# Defaults below mirror the values in docker-compose.yml (overridable).

# Retrieval / embeddings
SCOPUS_CSV=/app/resources/scopusdata.csv
SCOPUS_SEP=|
PKL_MIN_PATH=/app/resources/embeddings_meta_min.pkl
FAISS_PATH=/app/resources/faiss_index_ip.bin

# Language detection (fastText)
LID_MODEL_PATH=/app/resources/lid.176.ftz

# Re-ranking (cross-encoder)
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CE_BATCH_SIZE=64
W_CE=0.7
W_DENSE=0.3

# Ollama (service DNS inside compose, don't point at localhost)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=gemma3:4b
# Space-separated; pulled automatically by ollama-init on compose up
OLLAMA_PULL_MODELS=gemma3:4b qwen2.5:1.5b

# FastAPI port (must match the uvicorn CMD/__main__)
PORT=8181

# RAG params
RAG_TEMPERATURE=0.2
RAG_MAX_NEW_TOKENS=768
RAG_TOP_CONTEXT=6
RAG_MAX_INPUT_CHARS=7000
RAG_MAX_CHUNK_CHARS=900
RAG_TRIM_ABSTRACT=1
API_TOPK=100
RAG_HTTP_TIMEOUT_SECS=300
